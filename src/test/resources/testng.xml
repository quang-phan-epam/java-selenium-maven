<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DemoQA Automation Suite" verbose="1" parallel="tests" thread-count="3">
<listeners>
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
</listeners>
<parameter name="env" value="staging"/>
<test name="Bookstore Homepage Tests">
    <classes>
        <class name="tests.HomePageTest"/>
    </classes>
</test>

<test name="Login Tests">
    <classes>
        <class name="tests.LoginTest"/>
    </classes>
</test>

<test name="Frame Tests">
    <classes>
        <class name="tests.FrameTest"/>
    </classes>
</test>

<test name="Alerts Tests">
    <groups>
        <run>
            <include name="smoke"/>
            <exclude name="regression"/>
        </run>
    </groups>
    <classes>
        <class name="tests.AlertsTest">
            <!-- Include specific methods, and exclude one method as example -->
            <methods>
                <include name="testSimpleAlert"/>
                <include name="testConfirmPopupAccept"/>
                <include name="testPromptPopup"/>
                <exclude name="testConfirmPopupDismiss"/>
            </methods>
        </class>
    </classes>
</test>

<test name="File Upload Tests">
    <classes>
        <class name="tests.FileUploadTest"/>
    </classes>
</test>

<test name="Dropdown Tests">
    <classes>
        <class name="tests.DropdownTest"/>
    </classes>
</test>

</suite>
